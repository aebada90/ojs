# Copy to .ftp.env (gitignored) — values from Hostinger hPanel
# Websites → Dashboard → FTP Accounts

# FTP IP shown in hPanel (oktoberhub.de currently resolves to this)
FTP_HOST=84.32.84.86
FTP_USER=
FTP_PASSWORD=
FTP_PORT=21

# Where Laravel lives on the server
# Common: /public_html/platform/  OR  /public_html/  if artisan is at root
FTP_DIR=/public_html/platform/
