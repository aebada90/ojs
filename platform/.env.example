APP_NAME="Oktoberfest AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8888

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Database — SQLite for local Mac (same simple setup as other PHP projects)
# Switch to mysql for Hostinger production
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=your_database
# DB_USERNAME=your_username
# DB_PASSWORD=your_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Platform
PLATFORM_NAME="Oktoberfest AI"
PLATFORM_TAGLINE="The Ultimate AI-Powered Tourism & Festival Ecosystem"
PLATFORM_DEFAULT_LOCALE=en
PLATFORM_DEFAULT_CURRENCY=EUR
PLATFORM_DEFAULT_TIMEZONE=Europe/Berlin
PLATFORM_DEFAULT_CITY=Munich

# AI — Primary provider: openai | anthropic | external | tourism_os | eventos | marketplace_ai
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_FALLBACK_CHAIN=external,openai

# External project API (your other platform)
AI_EXTERNAL_ENABLED=false
AI_EXTERNAL_BASE_URL=https://your-api.example.com
AI_EXTERNAL_CHAT_ENDPOINT=/api/v1/chat
AI_EXTERNAL_API_KEY=
AI_EXTERNAL_AUTH_TYPE=bearer
AI_EXTERNAL_RESPONSE_KEY=reply

# TourismOS project API
AI_TOURISM_OS_ENABLED=false
AI_TOURISM_OS_URL=
AI_TOURISM_OS_API_KEY=
AI_TOURISM_OS_CHAT_ENDPOINT=/api/ai/chat
AI_TOURISM_OS_RESPONSE_KEY=message

# EventOS project API
AI_EVENTOS_ENABLED=false
AI_EVENTOS_URL=
AI_EVENTOS_API_KEY=
AI_EVENTOS_CHAT_ENDPOINT=/api/v1/assistant/chat
AI_EVENTOS_RESPONSE_KEY=response

# Marketplace AI project API
AI_MARKETPLACE_ENABLED=false
AI_MARKETPLACE_URL=
AI_MARKETPLACE_API_KEY=
AI_MARKETPLACE_CHAT_ENDPOINT=/api/chatbot
AI_MARKETPLACE_RESPONSE_KEY=reply

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Payments
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

VITE_APP_NAME="${APP_NAME}"
